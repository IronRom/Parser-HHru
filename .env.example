# hh_scraper — конфигурация по умолчанию
# Скопируйте в .env и заполните нужными значениями.
# Все параметры можно переопределить аргументами командной строки.

# Ключевые слова для поиска
HH_KEYWORD=devops engineer

# Количество страниц результатов (1–50, 20 вакансий на страницу)
HH_PAGES=1

# Папка для сохранения .md файлов
HH_OUTPUT=vacancies

# Регионы через запятую: названия или числовые ID hh.ru
# Примеры: россия | москва,спб | екатеринбург,новосибирск | 1,2,3
HH_AREAS=россия

# Формат работы через запятую (оставьте пустым — любой)
# Варианты: remote | fullday | shift | flexible | fly
HH_SCHEDULE=

# Тип занятости (оставьте пустым — любая)
# Варианты: full | part | project | probation | volunteer
HH_EMPLOYMENT=
